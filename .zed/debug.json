[
  {
    "label": "Build & debug",
    "build": {
      "command": "cmake",
      "args": ["--build", "build/Debug", "--parallel"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/build/Debug/built/bin/heap",
    "request": "launch",
    "adapter": "CodeLLDB",
    "initCommands": [
      "settings set plugin.symbol-file.pdb.reader native"
    ],
    "env": {
      "_NO_DEBUG_HEAP": "1"
    }
  }
]
